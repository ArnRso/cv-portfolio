---
import { SITE } from '../consts';

/* Le numéro de bon est décoratif : il évoque le carnet à souche, il n'identifie
   rien. Figé pour rester stable d'un build à l'autre. */
const NUMERO = 'BON N° 2026-0001';
---

<section class="ticketwrap" aria-labelledby="ticket-titre">
  <p class="tlabel">Un projet ? Détachez votre bon</p>

  <div class="ticket">
    <div class="stub">
      <b>{SITE.name}</b>
      <span class="stub-lines"
        >Développeur web<br />{SITE.city} · {SITE.area}</span
      >
      <span class="numero">{NUMERO}</span>
      <a class="stub-mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>

    <div class="tbody">
      <span class="scissors" aria-hidden="true">✂</span>
      <p class="kind">Bon à valoir — sans engagement</p>
      <h2 id="ticket-titre">Bon pour un devis gratuit</h2>
      <p class="pitch">
        Valable pour : création de site vitrine, refonte, visibilité Google ou
        outil sur-mesure. Réservé aux artisans du bâtiment de Gironde.
      </p>

      <div class="fields" aria-hidden="true">
        <div class="field">
          Entreprise<i>Votre nom ici</i>
        </div>
        <div class="field">
          Métier<i>plombier, maçon…</i>
        </div>
      </div>

      <a class="tcta" href="/contact">Utiliser mon bon</a>
    </div>
  </div>
</section>

<style>
  .ticketwrap {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .tlabel {
    text-align: center;
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-bottom: var(--space-sm);
  }

  .ticket {
    max-width: var(--container-narrow);
    margin-inline: auto;
    display: grid;
    grid-template-columns: var(--stub-width) 1fr;
    background: var(--paper-bg);
    color: var(--paper-ink);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    transform: rotate(-1deg);
  }

  /* La souche a son propre jeu de couleurs : son fond est sombre alors que
     le corps du bon reste clair. */
  .stub {
    border-right: var(--border-thick) dashed var(--paper-dash);
    padding: var(--space-md) var(--space-sm);
    background: var(--stub-bg);
    color: var(--stub-ink);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    justify-content: center;
  }

  .stub b {
    font-family: var(--font-ticket);
    font-size: var(--text-base);
  }

  .stub-lines {
    font-size: var(--text-xs);
    color: var(--stub-muted);
  }

  .stub-mail {
    font-size: var(--text-xs);
    color: var(--stub-accent);
    word-break: break-all;
  }

  .numero {
    font-family: var(--font-mono);
    font-weight: var(--weight-bold);
    font-size: var(--text-xs);
    color: var(--stub-accent);
  }

  .tbody {
    padding: var(--space-md);
    position: relative;
  }

  .scissors {
    position: absolute;
    left: calc(var(--space-xs) * -1);
    top: var(--space-2xs);
    font-size: var(--text-md);
    color: var(--paper-muted);
  }

  .kind {
    font-size: var(--text-xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--paper-accent-ink);
    margin-bottom: var(--space-3xs);
  }

  .tbody h2 {
    font-family: var(--font-ticket);
    font-weight: var(--weight-extrabold);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-2xs);
  }

  .pitch {
    font-size: var(--text-sm);
    color: var(--paper-muted);
    margin-bottom: var(--space-sm);
    max-width: var(--measure);
  }

  .fields {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-sm);
  }

  .field {
    font-size: var(--text-xs);
    color: var(--paper-muted);
  }

  .field i {
    display: block;
    font-style: normal;
    border-bottom: var(--border-thin) dotted var(--paper-dash);
    min-width: var(--field-width);
    padding: var(--space-3xs) 0;
    font-family: var(--font-hand);
    font-size: var(--text-md);
    color: var(--paper-ink);
  }

  .tcta {
    display: inline-block;
    background: var(--paper-accent);
    color: var(--paper-on-accent);
    font-weight: var(--weight-extrabold);
    font-size: var(--text-sm);
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: filter var(--duration-fast) var(--ease-out);
  }

  .tcta:hover {
    filter: brightness(1.12);
  }

  @media (max-width: 40em) {
    .ticket {
      grid-template-columns: 1fr;
      transform: none;
    }

    .stub {
      border-right: none;
      border-bottom: var(--border-thick) dashed var(--paper-dash);
    }

    .scissors {
      display: none;
    }
  }
</style>
