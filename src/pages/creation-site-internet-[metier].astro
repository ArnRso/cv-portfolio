---
/**
 * Page métier — une par corps de métier décrit dans src/data/metiers.ts.
 *
 * URL calquée sur la recherche visée (« création site internet couvreur »),
 * pour que l'intitulé du résultat corresponde à ce que la personne a tapé.
 *
 * Le contenu vit dans les données, pas ici : ajouter un métier ne demande
 * qu'une entrée dans METIERS — à condition d'avoir de la matière propre à
 * lui (voir le commentaire en tête de metiers.ts).
 */
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';
import { METIERS } from '../data/metiers';
import { SITE } from '../consts';

export function getStaticPaths() {
  return METIERS.map((metier) => ({
    params: { metier: metier.slug },
    props: { metier },
  }));
}

const { metier } = Astro.props;

/* Communes citées : les plus peuplées de la métropole, plus les pôles du
   département. Les mêmes que sur l'accueil, pour rester cohérent. */
const villes = [
  'Bordeaux',
  'Mérignac',
  'Pessac',
  'Talence',
  'Bègles',
  'Villenave-d’Ornon',
  'Saint-Médard-en-Jalles',
  'Le Bouscat',
  'Libourne',
  'Arcachon',
];

const url = `${SITE.url}/creation-site-internet-${metier.slug}`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Création de site internet pour ${metier.nom}`,
  serviceType: `Création de site internet pour ${metier.nom}`,
  description: metier.description,
  url,
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: { '@type': 'AdministrativeArea', name: 'Gironde' },
  audience: {
    '@type': 'BusinessAudience',
    name: `${metier.pluriel.charAt(0).toUpperCase()}${metier.pluriel.slice(1)} de Gironde`,
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: metier.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

/* Fil d'Ariane : Google l'affiche à la place de l'URL dans les résultats. */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Services',
      item: `${SITE.url}/services`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `Site internet pour ${metier.nom}`,
      item: url,
    },
  ],
};

/* Les autres métiers, pour le maillage en bas de page. */
const autres = METIERS.filter((m) => m.slug !== metier.slug);
---

<Layout
  title={metier.title}
  description={metier.description}
  schema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <section class="intro">
    <div class="container">
      <nav class="fil" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        <span aria-hidden="true">/</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Site internet pour {metier.nom}</span>
      </nav>
      <h1>Création de site internet pour {metier.nom} en Gironde</h1>
      <p>{metier.accroche}</p>
      <div class="ctas">
        <a class="btn btn-accent" href="/contact" data-track-loc="metier-hero">
          Demander un devis gratuit
        </a>
        <a class="btn btn-ghost-light" href={metier.demo.href}>
          Voir un exemple de site
        </a>
      </div>
    </div>
  </section>

  <Section
    headingId="enjeux"
    title={`Ce qui se joue pour ${metier.leNom} sur internet`}
  >
    <ul class="grid">
      {
        metier.enjeux.map((item) => (
          <li class="card">
            <h3>{item.titre}</h3>
            <p>{item.texte}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    headingId="contenus"
    title={`Ce que doit contenir le site ${metier.leNom}`}
    lede={`Ces éléments ne sont pas une liste générique : ce sont ceux qui font la différence pour ${metier.leNom}, et que la plupart des sites du secteur oublient.`}
    raised
  >
    <ol class="contenus">
      {
        metier.contenus.map((item, i) => (
          <li>
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3>{item.titre}</h3>
              <p>{item.texte}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section headingId="exemple" title="Un exemple concret">
    <p class="lede-demo">{metier.demo.texte}</p>
    <a class="capture" href={metier.demo.href}>
      <Image
        src={metier.demo.image}
        alt={metier.demo.alt}
        widths={[520, 1040]}
        sizes="(min-width: 60em) 1040px, 100vw"
        loading="lazy"
      />
      <span class="capture-label">
        Voir le site {metier.demo.nom} en entier
      </span>
    </a>
  </Section>

  <Section
    headingId="zone"
    title="Où j'interviens"
    lede={`J'accompagne les ${metier.pluriel} de Bordeaux Métropole et de toute la Gironde. Le travail se fait à distance et sur place, selon ce qui vous arrange.`}
    inverse
  >
    <ul class="villes taglist taglist-court">
      {villes.map((ville) => <li>{ville}</li>)}
    </ul>
  </Section>

  <Section
    headingId="questions"
    title={`Questions fréquentes des ${metier.pluriel}`}
  >
    <dl class="faq">
      {
        metier.faq.map((item) => (
          <div class="qa">
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section headingId="autres" title="Vous exercez un autre métier ?" raised>
    <p class="autres-lede">
      Je travaille avec tous les corps de métier du bâtiment. Voici deux autres
      exemples — et si le vôtre n'y est pas, la démarche reste la même.
    </p>
    <ul class="autres">
      {
        autres.map((m) => (
          <li>
            <a href={`/creation-site-internet-${m.slug}`}>
              Site internet pour {m.nom}
            </a>
          </li>
        ))
      }
      <li><a href="/services">Voir toutes les prestations</a></li>
    </ul>
  </Section>

  <CtaBand
    title={`Parlons de votre site ${metier.leNom === 'un électricien' ? "d'électricien" : `de ${metier.nom}`}`}
    text="Un premier échange pour comprendre votre activité, puis un devis clair. Sans engagement."
  />
</Layout>

<style>
  /* En-tête en aplat marine, comme /services et /cv. */
  .intro {
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    padding-block: var(--space-2xl);
  }

  .fil {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    opacity: 0.7;
    margin-bottom: var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .fil a {
    color: var(--color-on-inverse);
  }

  .intro h1 {
    font-size: var(--text-3xl);
    text-transform: uppercase;
    letter-spacing: var(--tracking-tighter);
    max-width: 20ch;
    border-left: var(--rule-height) solid var(--color-accent);
    padding-left: var(--space-md);
  }

  .intro p {
    margin-top: var(--space-md);
    font-size: var(--text-md);
    opacity: 0.82;
    max-width: 62ch;
    padding-left: calc(var(--rule-height) + var(--space-md));
  }

  .ctas {
    margin-top: var(--space-lg);
    padding-left: calc(var(--rule-height) + var(--space-md));
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--col-min-wide), 1fr));
    gap: var(--space-md);
  }

  @media (width >= 48em) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .card {
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }

  .card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2xs);
  }

  .card p {
    color: var(--color-on-inverse);
    opacity: 0.82;
    font-size: var(--text-sm);
  }

  .contenus {
    display: grid;
    gap: var(--space-md);
  }

  .contenus li {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    max-width: 68ch;
  }

  .num {
    font-family: var(--font-mono);
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    color: var(--color-accent-ink);
    flex: none;
    padding-top: 0.15em;
  }

  .contenus h3 {
    font-size: var(--text-md);
  }

  .contenus p {
    margin-top: var(--space-3xs);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .lede-demo {
    color: var(--color-muted);
    max-width: var(--measure);
    margin-bottom: var(--space-md);
  }

  /* La capture est un lien : tout le bloc est cliquable, et le libellé
     décrit la destination pour les lecteurs d'écran. */
  .capture {
    display: block;
    border: var(--border-heavy) solid var(--color-ink);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
  }

  .capture :global(img) {
    display: block;
    width: 100%;
    height: auto;
    /* La capture est une page entière : on n'en montre que le haut. */
    max-height: var(--capture-height);
    object-fit: cover;
    object-position: top;
  }

  .capture-label {
    display: block;
    background: var(--color-ink);
    color: var(--color-on-inverse);
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    padding: var(--space-2xs) var(--space-sm);
  }

  .capture:hover .capture-label {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .villes {
    margin-top: var(--space-md);
  }

  .faq {
    display: grid;
    gap: var(--space-md);
    max-width: var(--container-narrow);
  }

  .qa {
    border-top: var(--border-thick) solid var(--color-ink);
    padding-top: var(--space-sm);
  }

  dt {
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: var(--text-md);
    letter-spacing: var(--tracking-tight);
  }

  dd {
    margin-top: var(--space-3xs);
    color: var(--color-muted);
  }

  .autres-lede {
    color: var(--color-muted);
    max-width: var(--measure);
  }

  .autres {
    margin-top: var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    font-weight: var(--weight-semibold);
  }
</style>
