---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { cv } from '../data/cv';

const { basics } = cv;
const linkedin = basics.profiles[0];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: basics.name,
  jobTitle: 'Développeur Full Stack',
  description: basics.summary,
  email: `mailto:${basics.email}`,
  url: basics.url,
  address: {
    '@type': 'PostalAddress',
    addressLocality: basics.location.city,
    addressRegion: basics.location.region,
    addressCountry: basics.location.countryCode,
  },
  sameAs: [linkedin.url],
  knowsLanguage: cv.languages.map((l) => l.language),
  alumniOf: cv.education.map((e) => ({
    '@type': 'EducationalOrganization',
    name: e.institution,
  })),
};

const period = (start: string, end: string | null) =>
  end ? `${start} – ${end}` : `${start} → aujourd'hui`;
---

<Layout
  title="CV — Adrien Russo, développeur full stack Symfony / Vue.js à Bordeaux"
  description="Développeur full stack avec 7 ans d'expérience, spécialisé dans les applications web sécurisées. Parcours, compétences, enseignement et projets. Bordeaux."
  schema={[personSchema]}
>
  <section class="head">
    <div class="container">
      <h1>{basics.name}</h1>
      <p class="label">{basics.label}</p>
      <p class="tagline">{basics.tagline} · {basics.location.city}, France</p>

      <div class="actions">
        {/* Le PDF est produit par la CI ; en local le fichier peut manquer. */}
        <a class="btn primary" href="/adrien-russo-cv.pdf" download>
          Télécharger mon CV (PDF)
        </a>
        <a class="btn ghost" href="/contact">Me contacter</a>
      </div>

      <ul class="coords">
        <li><a href={`mailto:${basics.email}`}>{basics.email}</a></li>
        <li>
          <a href={linkedin.url} rel="me noopener">
            linkedin.com/in/{linkedin.username}
          </a>
        </li>
      </ul>
    </div>
  </section>

  <Section headingId="profil" title="Profil">
    <p class="prose">{basics.summary}</p>
  </Section>

  <Section headingId="competences" title="Compétences" raised>
    <ul class="skills">
      {
        cv.skills.map((group) => (
          <li>
            <h3>{group.domain}</h3>
            <ul class="tags">
              {group.keywords.map((k) => (
                <li>{k}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section headingId="experiences" title="Expériences">
    <ol class="timeline">
      {
        cv.work.map((job) => (
          <li>
            <p class="when">{period(job.startDate, job.endDate)}</p>
            <div>
              <h3>
                {job.position} — {job.company}
              </h3>
              <p class="where">{job.location}</p>
              <p class="summary">{job.summary}</p>
              <ul class="bullets">
                {job.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section headingId="enseignement" title="Enseignement" raised>
    <ol class="timeline">
      {
        cv.teaching.map((t) => (
          <li>
            <p class="when">{t.period}</p>
            <div>
              <h3>{t.institution}</h3>
              <p class="where">{t.role}</p>
              <p class="summary">{t.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section headingId="projets" title="Projets notables">
    <ul class="projects">
      {
        cv.projects.map((p) => (
          <li>
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <a href={p.url} rel="noopener">
              {p.url.replace('https://', '')}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="note">{cv.projectsNote}</p>
  </Section>

  <Section headingId="formation" title="Formation & langues" raised>
    <div class="two">
      <div>
        <h3>Formation</h3>
        <ul class="plain">
          {
            cv.education.map((e) => (
              <li>
                <strong>{e.area}</strong>
                <span>
                  {e.institution} · {e.period}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3>Langues</h3>
        <ul class="plain">
          {
            cv.languages.map((l) => (
              <li>
                <strong>{l.language}</strong>
                <span>{l.fluency}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>
</Layout>

<style>
  .head {
    padding-block: var(--space-2xl) var(--space-lg);
  }

  .head h1 {
    font-size: var(--text-3xl);
    text-transform: uppercase;
    letter-spacing: var(--tracking-tighter);
  }

  .head .label {
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-lg);
    color: var(--color-primary);
  }

  .head .tagline {
    color: var(--color-muted);
    margin-top: var(--space-3xs);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
    margin-top: var(--space-md);
  }

  .btn {
    font-weight: var(--weight-extrabold);
    font-size: var(--text-sm);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
  }

  .primary {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .ghost {
    border: var(--border-thick) solid var(--color-ink);
    color: var(--color-ink);
  }

  .coords {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    margin-top: var(--space-md);
    font-size: var(--text-sm);
  }

  .prose {
    font-size: var(--text-md);
    color: var(--color-muted);
    max-width: 62ch;
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--col-min-wide), 1fr));
    gap: var(--space-md);
  }

  .skills h3,
  .projects h3,
  .two h3 {
    font-size: var(--text-md);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-2xs);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }

  .tags li {
    background: var(--color-surface);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3xs) var(--space-2xs);
    font-size: var(--text-xs);
  }

  .timeline {
    display: grid;
    gap: var(--space-xl);
  }

  .timeline li {
    display: grid;
    grid-template-columns: var(--col-date) 1fr;
    gap: var(--space-md);
    border-top: var(--border-thin) solid var(--color-border);
    padding-top: var(--space-md);
  }

  .when {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    padding-top: var(--space-3xs);
  }

  .timeline h3 {
    font-size: var(--text-lg);
  }

  .where {
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    margin-top: var(--space-3xs);
  }

  .summary {
    margin-top: var(--space-2xs);
    color: var(--color-muted);
    max-width: 62ch;
  }

  .bullets {
    margin-top: var(--space-2xs);
    display: grid;
    gap: var(--space-2xs);
    max-width: 66ch;
  }

  .bullets li {
    position: relative;
    padding-left: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: var(--space-2xs);
    height: var(--border-thick);
    background: var(--color-accent);
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--col-min-wide), 1fr));
    gap: var(--space-md);
  }

  .projects li {
    background: var(--color-surface);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }

  .projects p {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-2xs);
  }

  .projects a {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }

  .note {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-style: italic;
  }

  .two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--col-min-wide), 1fr));
    gap: var(--space-lg);
  }

  .plain {
    display: grid;
    gap: var(--space-sm);
  }

  .plain strong {
    display: block;
    font-weight: var(--weight-semibold);
  }

  .plain span {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  @media (max-width: 40em) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }
  }

  @media print {
    .actions {
      display: none;
    }

    .head {
      padding-block: 0 var(--space-sm);
    }
  }
</style>
