---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { cv } from '../data/cv';

const { basics } = cv;
const linkedin = basics.profiles[0];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: basics.name,
  jobTitle: 'Développeur Full Stack',
  description: basics.summary,
  email: `mailto:${basics.email}`,
  url: basics.url,
  address: {
    '@type': 'PostalAddress',
    addressLocality: basics.location.city,
    addressRegion: basics.location.region,
    addressCountry: basics.location.countryCode,
  },
  sameAs: [linkedin.url],
  knowsLanguage: cv.languages.map((l) => l.language),
  alumniOf: cv.education.map((e) => ({
    '@type': 'EducationalOrganization',
    name: e.institution,
  })),
};

const period = (start: string, end: string | null) =>
  end ? `${start} – ${end}` : `${start} → aujourd'hui`;
---

<Layout
  title="CV — Adrien Russo, développeur full stack Symfony / Vue.js à Bordeaux"
  description="Développeur full stack avec 7 ans d'expérience, spécialisé dans les applications web sécurisées. Parcours, compétences et enseignement. Bordeaux."
  schema={[personSchema]}
>
  <section class="head">
    <div class="container head-inner">
      <div class="identity">
        <p class="eyebrow">Curriculum vitæ</p>
        <h1>{basics.name}</h1>
        <p class="role">{basics.label}</p>
        <p class="tagline">
          {basics.tagline} · {basics.location.city}, France
        </p>

        <p class="summary">{basics.summary}</p>

        <div class="actions">
          {
            /* Le PDF est produit par la CI ; en local le fichier peut manquer. */
          }
          <a class="btn btn-accent" href="/adrien-russo-cv.pdf" download>
            Télécharger le PDF
          </a>
          <a class="btn btn-ghost-light" href={`mailto:${basics.email}`}>
            {basics.email}
          </a>
          <a class="btn btn-ghost-light" href={linkedin.url} rel="me noopener">
            LinkedIn
          </a>
        </div>
      </div>

      <ul class="facts">
        {
          cv.facts.map((fact) => (
            <li>
              <span class="fact-value">{fact.value}</span>
              <span class="fact-label">{fact.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Section headingId="experiences" title="Parcours" raised>
    <ol class="jobs">
      {
        cv.work.map((job) => (
          <li class="job">
            <header class="job-head">
              <div>
                <h3>{job.position}</h3>
                <p class="company">
                  {job.url ? (
                    <a href={job.url} rel="noopener">
                      {job.company}
                    </a>
                  ) : (
                    job.company
                  )}
                  <span class="sep">·</span>
                  <span class="place">{job.location}</span>
                </p>
              </div>
              <p class="when">{period(job.startDate, job.endDate)}</p>
            </header>

            <p class="job-summary">{job.summary}</p>

            <ul class="bullets">
              {job.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>

            <ul class="stack">
              {job.stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section headingId="competences" title="Compétences">
    <ul class="skills">
      {
        cv.skills.map((group) => (
          <li class="skill">
            <h3>{group.domain}</h3>
            <p>{group.keywords.join(' · ')}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section headingId="enseignement" title="Enseignement" inverse>
    <p class="lede-inverse">
      Je transmets mon métier dans trois écoles de développement bordelaises.
    </p>
    <ol class="teach">
      {
        cv.teaching.map((t) => (
          <li>
            <p class="teach-when">{t.period}</p>
            <h3>{t.institution}</h3>
            <p class="teach-role">{t.role}</p>
            <p class="teach-detail">{t.detail}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section headingId="formation" title="Formation & langues" raised>
    <div class="two">
      <div>
        <h3 class="sub">Formation</h3>
        <ul class="plain">
          {
            cv.education.map((e) => (
              <li>
                <span class="plain-when">{e.period}</span>
                <strong>{e.area}</strong>
                <span class="plain-where">{e.institution}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="sub">Langues</h3>
        <ul class="plain">
          {
            cv.languages.map((l) => (
              <li>
                <strong>{l.language}</strong>
                <span class="plain-where">{l.fluency}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>
</Layout>

<style>
  /* ---- En-tête : aplat marine, chiffres clés en vis-à-vis ---------- */
  .head {
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    padding-block: var(--space-2xl);
  }

  .head-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-accent);
    margin-bottom: var(--space-2xs);
  }

  h1 {
    font-size: var(--text-3xl);
    text-transform: uppercase;
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-tight);
  }

  .role {
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-lg);
  }

  .tagline {
    margin-top: var(--space-3xs);
    opacity: 0.75;
    font-size: var(--text-sm);
  }

  .summary {
    margin-top: var(--space-md);
    max-width: 58ch;
    opacity: 0.88;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-md);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--border-thick);
    background: rgb(255 255 255 / 0.16);
    border: var(--border-thick) solid rgb(255 255 255 / 0.16);
  }

  .facts li {
    background: var(--color-inverse);
    padding: var(--space-sm);
  }

  .fact-value {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    color: var(--color-accent);
  }

  .fact-label {
    display: block;
    margin-top: var(--space-3xs);
    font-size: var(--text-xs);
    opacity: 0.75;
  }

  /* ---- Parcours : cartes plutôt qu'une frise ---------------------- */
  .jobs {
    display: grid;
    gap: var(--space-md);
  }

  .job {
    background: var(--color-surface);
    border-left: var(--rule-height) solid var(--color-accent);
    padding: var(--space-md);
  }

  .job-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-md);
  }

  .job h3 {
    font-size: var(--text-lg);
  }

  .company {
    margin-top: var(--space-3xs);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
  }

  .company a {
    color: var(--color-ink);
  }

  .sep {
    margin-inline: var(--space-3xs);
    color: var(--color-accent-ink);
  }

  .place {
    font-weight: var(--weight-regular);
    color: var(--color-muted);
  }

  .when {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    padding: var(--space-3xs) var(--space-2xs);
    white-space: nowrap;
  }

  .job-summary {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    max-width: 68ch;
  }

  .bullets {
    margin-top: var(--space-sm);
    display: grid;
    gap: var(--space-2xs);
    max-width: 72ch;
  }

  .bullets li {
    position: relative;
    padding-left: var(--space-sm);
    font-size: var(--text-sm);
  }

  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: var(--space-2xs);
    height: var(--border-heavy);
    background: var(--color-accent);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: var(--border-thin) solid var(--color-border);
  }

  .stack li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    border: var(--border-thin) solid var(--color-border);
    padding: var(--space-3xs) var(--space-2xs);
  }

  /* ---- Compétences : blocs lisibles, pas des confettis ------------ */
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--col-min-wide), 1fr));
    gap: var(--border-thick);
    background: var(--color-border);
    border: var(--border-thick) solid var(--color-ink);
  }

  .skill {
    background: var(--color-surface);
    padding: var(--space-md);
  }

  .skill h3 {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-accent-ink);
    margin-bottom: var(--space-2xs);
  }

  .skill p {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  /* ---- Enseignement : sur aplat marine ---------------------------- */
  .lede-inverse {
    color: var(--color-on-inverse);
    opacity: 0.82;
    max-width: var(--measure);
    margin-bottom: var(--space-lg);
  }

  .teach {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--col-min), 1fr));
    gap: var(--space-md);
  }

  .teach li {
    border-top: var(--border-heavy) solid var(--color-accent);
    padding-top: var(--space-sm);
  }

  .teach-when {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    margin-bottom: var(--space-3xs);
  }

  .teach h3 {
    font-size: var(--text-md);
  }

  .teach-role {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    margin-top: var(--space-3xs);
  }

  .teach-detail {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    opacity: 0.75;
  }

  /* ---- Formation & langues --------------------------------------- */
  .two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--col-min-wide), 1fr));
    gap: var(--space-lg);
  }

  .sub {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-accent-ink);
    margin-bottom: var(--space-sm);
  }

  .plain {
    display: grid;
    gap: var(--space-sm);
  }

  .plain li {
    border-left: var(--border-thick) solid var(--color-border);
    padding-left: var(--space-sm);
  }

  .plain-when {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .plain strong {
    display: block;
    font-weight: var(--weight-semibold);
  }

  .plain-where {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  @media (max-width: 48em) {
    .head-inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  @media print {
    .actions {
      display: none;
    }

    .head {
      padding-block: 0 var(--space-sm);
    }
  }
</style>
