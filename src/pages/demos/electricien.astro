---
import { Image } from 'astro:assets';
import DemoLayout from '../../layouts/DemoLayout.astro';
import hero from '../../assets/demos/electricien/hero.webp';
import real1 from '../../assets/demos/electricien/real1.webp';
import real2 from '../../assets/demos/electricien/real2.webp';
import real3 from '../../assets/demos/electricien/real3.webp';
import '../../styles/demos/electricien.css';

const menu = [
  { href: '#prestations', label: 'Prestations' },
  { href: '#chantiers', label: 'Chantiers' },
  { href: '#zone', label: 'Zone d’intervention' },
  { href: '#contact', label: 'Devis' },
];

/* Accordéon : le premier volet est ouvert pour que la section ne se présente
   pas comme une liste de titres fermés. */
const prestations = [
  {
    titre: 'Installation & mise aux normes',
    texte:
      'Réfection complète du réseau électrique d’un logement ou d’un local, remplacement de tableau, mise en conformité NF C 15-100 et attestation Consuel.',
    details: [
      'Tableau électrique et différentiels 30 mA',
      'Reprise de la mise à la terre',
      'Remplacement des câbles vétustes',
      'Diagnostic avant travaux',
      'Attestation Consuel fournie',
    ],
  },
  {
    titre: 'Bornes de recharge IRVE',
    texte:
      'Installation de bornes pour véhicule électrique en maison individuelle ou en copropriété, avec comptage individuel par logement si nécessaire.',
    details: [
      'Bornes 7 à 22 kW',
      'Copropriétés avec sous-comptage',
      'Qualification IRVE obligatoire',
      'Accompagnement sur les aides',
    ],
  },
  {
    titre: 'Domotique & pilotage',
    texte:
      'Éclairage, volets et chauffage réunis sur une seule interface. Installation filaire KNX pour une construction, ou sans fil sur un logement existant.',
    details: [
      'Scénarios d’éclairage',
      'Volets et stores motorisés',
      'Thermostats connectés',
      'Pilotage depuis un smartphone',
    ],
  },
  {
    titre: 'Éclairage & courant faible',
    texte:
      'Éclairage intérieur et extérieur, réseau informatique, baie de brassage et couverture Wi-Fi pour les logements comme pour les locaux professionnels.',
    details: [
      'Éclairage LED et architectural',
      'Prises RJ45 et baie de brassage',
      'Éclairage extérieur et de sécurité',
      'Interphonie et contrôle d’accès',
    ],
  },
  {
    titre: 'Dépannage',
    texte:
      'Panne totale ou partielle, disjonction répétée, court-circuit, prise qui chauffe. Intervention rapide sur Bordeaux Métropole, diagnostic avant tout devis.',
    details: [
      'Recherche de panne',
      'Disjoncteur qui saute',
      'Remise en service',
      'Sécurisation immédiate',
    ],
  },
];

const chantiers = [
  {
    img: real1,
    alt: 'Salon rénové avec éclairage encastré dans un appartement ancien',
    lieu: 'Bordeaux Chartrons',
    titre: 'Rénovation électrique d’un appartement haussmannien',
    texte:
      'Réfection totale du réseau sur un logement de 1890 dont l’installation datait des années soixante. Passage des gaines sans toucher aux moulures, tableau reporté dans un placard technique.',
    faits: [
      ['Surface', '95 m²'],
      ['Durée', '3 semaines'],
      ['Livré', 'Mars 2026'],
    ],
  },
  {
    img: real2,
    alt: 'Tableau électrique neuf avec circuits repérés',
    lieu: 'Pessac',
    titre: 'Remplacement de tableau et remise aux normes',
    texte:
      'Installation devenue dangereuse : fusibles porcelaine, absence de terre sur une partie des circuits. Tableau neuf, différentiels 30 mA, repérage complet et attestation Consuel.',
    faits: [
      ['Circuits', '24'],
      ['Durée', '4 jours'],
      ['Livré', 'Janvier 2026'],
    ],
  },
  {
    img: real3,
    alt: 'Cuisine contemporaine avec éclairage LED intégré',
    lieu: 'Mérignac',
    titre: 'Éclairage sur mesure d’une cuisine ouverte',
    texte:
      'Trois circuits distincts pilotés indépendamment : plan de travail, îlot et éclairage d’ambiance. Bandeaux LED encastrés, variation par scénario depuis un interrupteur mural ou le téléphone.',
    faits: [
      ['Circuits', '3 zones'],
      ['Durée', '5 jours'],
      ['Livré', 'Novembre 2025'],
    ],
  },
];

const secteurs = [
  ['Mérignac', 'sous 24 h'],
  ['Bordeaux', 'sous 24 h'],
  ['Pessac', 'sous 24 h'],
  ['Le Bouscat', 'sous 24 h'],
  ['Talence', 'sous 48 h'],
  ['Bruges', 'sous 48 h'],
  ['Eysines', 'sous 48 h'],
  ['Gradignan', 'sous 48 h'],
  ['Villenave-d’Ornon', 'sous 48 h'],
  ['Saint-Médard-en-Jalles', 'sous 48 h'],
];
---

<DemoLayout
  title="Voltek — Électricien à Bordeaux (démonstration)"
  description="Site de démonstration : entreprise fictive d’électricité générale, domotique et bornes de recharge en Gironde."
  entreprise="Voltek"
>
  <div class="dm-elec">
    <header class="rail">
      <p class="logo">
        Vol<span>tek</span>
        <small>Électricité générale</small>
      </p>

      <nav aria-label="Navigation principale">
        <ol>
          {
            menu.map((m) => (
              <li>
                <a href={m.href}>{m.label}</a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="rail-pied">
        <strong>Atelier</strong>
        <p>Avenue de l’Yser<br />33700 Mérignac</p>
        <strong>Horaires</strong>
        <p>Lundi au vendredi<br />8 h – 18 h</p>
      </div>
    </header>

    <div class="corps">
      <section class="hero">
        <Image
          src={hero}
          alt="Électricien intervenant sur un tableau électrique"
          widths={[900, 1400, 1900]}
          sizes="100vw"
          loading="eager"
        />
        <div class="hero-txt">
          <p class="kicker">Bordeaux Métropole · depuis 2011</p>
          <h1>L’électricité de votre logement, reprise dans les règles</h1>
          <p class="accroche">
            Mise aux normes, bornes de recharge et domotique. Un artisan
            qualifié qui vous explique ce qu’il fait et pourquoi.
          </p>
          <div class="hero-appel">
            <a class="tel" href="#contact">
              <small>Un problème électrique ?</small>
              05 00 00 00 00
            </a>
            <a class="btn btn-plein" href="#contact">Demander un devis</a>
          </div>
        </div>
      </section>

      <section id="prestations" class="bloc">
        <div class="tete">
          <p class="no">01</p>
          <div>
            <h2>Ce que nous prenons en charge</h2>
            <p>
              Du remplacement d’un tableau à l’installation d’une borne de
              recharge en copropriété. Dépliez ce qui vous concerne.
            </p>
          </div>
        </div>

        <div class="accordeon">
          {
            prestations.map((p, i) => (
              <details open={i === 0}>
                <summary>
                  <span class="rang">{String(i + 1).padStart(2, '0')}</span>
                  {p.titre}
                </summary>
                <div class="contenu">
                  <p>{p.texte}</p>
                  <ul>
                    {p.details.map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                </div>
              </details>
            ))
          }
        </div>
      </section>

      <section id="chantiers">
        <div class="bloc">
          <div class="tete">
            <p class="no">02</p>
            <div>
              <h2>Trois chantiers, expliqués</h2>
              <p>
                Plutôt qu’une galerie de photos, ce que le chantier posait comme
                problème et comment il a été traité.
              </p>
            </div>
          </div>
        </div>

        <div class="chantiers">
          {
            chantiers.map((c) => (
              <article class="chantier">
                <div class="visuel">
                  <Image
                    src={c.img}
                    alt={c.alt}
                    widths={[600, 1100]}
                    sizes="(max-width: 1080px) 100vw, 55vw"
                    loading="lazy"
                  />
                </div>
                <div class="texte">
                  <p class="lieu">{c.lieu}</p>
                  <h3>{c.titre}</h3>
                  <p>{c.texte}</p>
                  <dl>
                    {c.faits.map(([cle, valeur]) => (
                      <div>
                        <dt>{cle}</dt>
                        <dd>{valeur}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="zone" class="bloc fond-vert">
        <div class="tete">
          <p class="no">03</p>
          <div>
            <h2>Où nous intervenons, et sous quel délai</h2>
            <p>
              Basés à Mérignac. Les délais indiqués valent pour une première
              visite, hors urgence.
            </p>
          </div>
        </div>

        <dl class="secteurs">
          {
            secteurs.map(([ville, delai]) => (
              <div>
                <dt>{ville}</dt>
                <dd>{delai}</dd>
              </div>
            ))
          }
        </dl>

        <p class="hors-zone">
          Votre commune n’est pas dans la liste ? Nous nous déplaçons dans toute
          la Gironde selon la nature du chantier. Posez la question.
        </p>
      </section>

      <section id="contact" class="bloc fond-creme">
        <div class="contact-tete">
          <h2>Décrivez votre projet, nous vous rappelons</h2>
          <a class="contact-tel" href="#contact">
            <small>Ou appelez directement</small>
            05 00 00 00 00
          </a>
        </div>

        <form
          onsubmit="event.preventDefault(); alert('Démonstration — le formulaire n’envoie rien.');"
        >
          <p class="champ">
            <label for="nom">Nom</label>
            <input id="nom" type="text" required />
          </p>
          <p class="champ">
            <label for="tel">Téléphone</label>
            <input id="tel" type="tel" required />
          </p>
          <p class="champ">
            <label for="commune">Commune</label>
            <input id="commune" type="text" required />
          </p>
          <p class="champ">
            <label for="type">Nature du projet</label>
            <select id="type" required>
              <option value="">À préciser</option>
              <option>Mise aux normes</option>
              <option>Borne de recharge</option>
              <option>Domotique</option>
              <option>Éclairage</option>
              <option>Dépannage</option>
            </select>
          </p>
          <p class="champ champ-large">
            <label for="projet">Votre projet</label>
            <textarea id="projet" rows="4" required></textarea>
          </p>
          <button type="submit">Envoyer ma demande</button>
        </form>

        <p class="mentions">
          Devis et déplacement gratuits sur Bordeaux Métropole. Réponse sous 48
          h ouvrées.
        </p>
      </section>
    </div>
  </div>
</DemoLayout>
