---
/**
 * Enveloppe des sites de démonstration.
 *
 * Ces pages présentent des entreprises fictives : elles portent un bandeau
 * explicite et sont interdites aux moteurs. Sans cela, Google pourrait les
 * lire comme du contenu trompeur et sanctionner tout le domaine.
 *
 * Chaque démo apporte sa propre feuille de style, sans lien avec tokens.css :
 * l'intérêt de l'exercice est de montrer des identités visuelles distinctes.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/archivo';
/* Titrage de la démo menuisier. */
import '@fontsource-variable/bricolage-grotesque';
/* Uniquement pour la modale de soumission, qui parle en mon nom et porte
   donc mon identité. Ce fichier ne déclare que des variables : il n'impose
   rien au style des démos. */
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  /** Nom de l'entreprise fictive, affiché dans le bandeau. */
  entreprise: string;
}

const { title, description, entreprise } = Astro.props;

/* Le visiteur arrive de /realisations : c'est là qu'il doit pouvoir revenir,
   sur la fiche de cette démo précisément. L'ancre se déduit de l'URL. */
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop();
const retour = `/realisations#${slug}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Ces pages ne doivent jamais être indexées ni suivies. */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body>
    {
      /* Le retour d'abord — c'est la sortie de la démo, et il vient donc en
        premier au clavier comme à l'écran. */
    }
    <div class="demo-bandeau">
      <a class="demo-bandeau-retour" href={retour}>← Retour aux réalisations</a>
      <p>
        <strong>Démonstration</strong> — {entreprise} est une entreprise fictive.
      </p>
    </div>

    <slot />

    {
      /*
      Retour de soumission des formulaires. Plutôt qu'un alert() qui casse
      l'immersion, on montre au visiteur ce que son propre site lui
      apporterait — le bandeau se charge déjà de dire que c'est une démo.
    */
    }
    <dialog class="demo-modale" aria-labelledby="demo-modale-titre">
      <div class="demo-modale-boite">
        <p class="demo-modale-eyebrow">Nouvelle demande de devis</p>
        <h2 id="demo-modale-titre">
          Si c'était votre site, ce mail serait pour vous.
        </h2>
        <p class="demo-modale-texte">
          Une demande de devis vient d'arriver. Sur votre site, elle tomberait
          dans votre boîte mail en quelques secondes — nom, téléphone, commune
          et détail du chantier. Vous rappelez, vous décrochez le devis.
        </p>

        <p class="demo-modale-actions">
          <a class="demo-modale-cta" href="/contact">Je veux ce site</a>
          <button class="demo-modale-lien" type="button" data-fermer
            >Continuer la visite</button
          >
        </p>

        {
          /* En dernier dans le DOM : le focus initial doit se poser sur
            l'action utile, pas sur la croix de fermeture. */
        }
        <button
          class="demo-modale-fermer"
          type="button"
          data-fermer
          aria-label="Fermer">×</button
        >
      </div>
    </dialog>

    <script>
      /* Publie la hauteur réelle du bandeau : une démo à navigation fixe doit
         pouvoir s'y adosser, et cette hauteur change quand le texte passe sur
         deux lignes. */
      const bandeau = document.querySelector<HTMLElement>('.demo-bandeau');

      if (bandeau) {
        const mesurer = () =>
          document.documentElement.style.setProperty(
            '--demo-bandeau-h',
            `${bandeau.offsetHeight}px`,
          );

        mesurer();
        new ResizeObserver(mesurer).observe(bandeau);
      }

      /* Les formulaires des démos ne mènent nulle part : on intercepte la
         soumission et on ouvre le dialogue à la place. showModal() apporte
         déjà le piège à focus, la fermeture par Échap et l'inertie du fond. */
      const modale = document.querySelector<HTMLDialogElement>('.demo-modale');

      if (modale) {
        for (const form of document.querySelectorAll('form')) {
          form.addEventListener('submit', (e) => {
            e.preventDefault();
            modale.showModal();
            form.reset();
          });
        }

        for (const bouton of modale.querySelectorAll('[data-fermer]')) {
          bouton.addEventListener('click', () => modale.close());
        }

        /* Clic sur le fond : tout le contenu vit dans .demo-modale-boite,
           donc un clic dont la cible est le <dialog> vient de l'extérieur. */
        modale.addEventListener('click', (e) => {
          if (e.target === modale) modale.close();
        });
      }
    </script>

    <footer class="demo-pied">
      {/* Espace explicite : le saut de ligne avant le lien serait avalé. */}
      <p>
        {'Site de démonstration réalisé par '}
        <a href="/">Adrien Russo</a>, développeur web à Bordeaux.
      </p>
      <p class="demo-pied-note">
        Entreprise, coordonnées et chantiers fictifs.
      </p>
      <p class="demo-pied-liens">
        <a href={retour}>← Retour aux réalisations</a>
        <a class="demo-pied-cta" href="/contact"
          >Demander un devis pour mon site</a
        >
      </p>
    </footer>

    <style is:global>
      /* Ces pages n'utilisent pas base.css : sans cette remise à zéro, la
         marge par défaut du navigateur cerne la page d'un liseré blanc. */
      body {
        margin: 0;
      }

      /* Les démos naviguent entièrement par ancres. */
      html {
        scroll-behavior: smooth;
      }

      /* Le bandeau est collant : sans cette marge, la cible d'une ancre
         arrive dessous et sa première ligne est masquée. */
      :target {
        scroll-margin-top: var(--demo-bandeau-h, 40px);
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      /* Styles du bandeau et du pied de page, communs à toutes les démos.
         Volontairement neutres : ils ne doivent pas se confondre avec
         l'identité de la démo qu'ils encadrent. */
      .demo-bandeau {
        position: sticky;
        top: 0;
        /* Au-dessus du contenu de la démo, mais une démo à navigation fixe
           doit pouvoir se placer dessous : voir --demo-bandeau-h. */
        z-index: 999;
        /* Mention et bouton forment un seul groupe centré : séparés aux deux
           bouts, l'œil doit faire deux arrêts pour lire le bandeau. */
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 8px 16px;
        padding: 10px 20px;
        background: #1a1a1a;
        color: #fff;
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        font-size: 13px;
        line-height: 1.4;
      }

      .demo-bandeau p {
        text-align: center;
      }

      .demo-bandeau strong {
        color: #ffc300;
      }

      .demo-bandeau a {
        color: #fff;
        text-decoration: underline;
        text-underline-offset: 3px;
        white-space: nowrap;
      }

      /* Le retour se lit comme un bouton : au bord d'un bandeau sombre, un
         lien souligné passe inaperçu. */
      .demo-bandeau-retour {
        flex: none;
        padding: 5px 12px;
        border: 1px solid rgb(255 255 255 / 0.4);
        border-radius: var(--radius-pill);
        text-decoration: none !important;
        font-weight: 600;
      }

      .demo-bandeau-retour:hover {
        background: #fff;
        color: #1a1a1a;
        border-color: #fff;
      }

      /* Trop étroit pour une rangée : la mention passe au-dessus, elle pose
         le cadre, et le bouton se centre dessous. */
      @media (max-width: 620px) {
        .demo-bandeau p {
          order: -1;
        }
      }

      .demo-pied {
        padding: 48px 24px;
        background: #1a1a1a;
        color: #fff;
        text-align: center;
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        font-size: 14px;
        line-height: 1.6;
      }

      .demo-pied a {
        color: #ffc300;
      }

      .demo-pied-note {
        margin-top: 8px;
        opacity: 0.55;
        font-size: 12.5px;
      }

      /* Le retour reste discret : le bouton jaune porte l'action principale. */
      .demo-pied-liens > a:not(.demo-pied-cta) {
        color: #fff;
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .demo-pied-liens {
        display: flex;
        flex-wrap: wrap;
        gap: 14px 24px;
        align-items: center;
        justify-content: center;
        margin-top: 22px;
      }

      .demo-pied-cta {
        display: inline-block;
        padding: 12px 24px;
        background: #ffc300;
        color: #0f2747 !important;
        font-weight: 700;
        border-radius: 100px;
        text-decoration: none;
      }

      /* ---- Modale de soumission --------------------------------------
         C'est moi qui m'adresse au visiteur, pas l'entreprise fictive :
         elle porte donc mon identité, la même sur toutes les démos. */
      .demo-modale {
        margin: auto;
        padding: 0;
        border: 0;
        max-width: 30rem;
        width: calc(100% - var(--space-md));
        background: transparent;
        color: var(--color-ink);
      }

      .demo-modale::backdrop {
        background: rgb(15 39 71 / 0.66);
        backdrop-filter: blur(3px);
      }

      .demo-modale-boite {
        position: relative;
        padding: var(--space-lg) var(--space-lg) var(--space-md);
        background: var(--color-bg);
        border-top: var(--rule-height) solid var(--color-accent);
        border-radius: var(--radius-sm);
        box-shadow: var(--shadow-lg);
        font-family: var(--font-body);
        text-align: left;
      }

      /* L'apparition confirme l'action sans faire attendre. */
      .demo-modale[open] .demo-modale-boite {
        animation: demo-modale-entree var(--duration-slow) var(--ease-out);
      }

      @keyframes demo-modale-entree {
        from {
          opacity: 0;
          transform: translateY(12px) scale(0.98);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .demo-modale[open] .demo-modale-boite {
          animation: none;
        }
      }

      .demo-modale-fermer {
        position: absolute;
        top: var(--space-2xs);
        right: var(--space-2xs);
        width: var(--space-lg);
        height: var(--space-lg);
        display: grid;
        place-items: center;
        border: 0;
        background: transparent;
        color: var(--color-muted);
        font-size: var(--text-xl);
        line-height: 1;
        cursor: pointer;
        border-radius: var(--radius-pill);
      }

      .demo-modale-fermer:hover {
        background: var(--color-surface-raised);
        color: var(--color-ink);
      }

      .demo-modale-eyebrow {
        font-family: var(--font-display);
        font-weight: var(--weight-extrabold);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-widest);
        text-transform: uppercase;
        color: var(--color-accent-ink);
        margin-bottom: var(--space-2xs);
      }

      .demo-modale h2 {
        margin: 0;
        font-family: var(--font-display);
        font-size: var(--text-lg);
        font-weight: var(--weight-black);
        line-height: var(--leading-snug);
        letter-spacing: var(--tracking-tight);
        color: var(--color-ink);
      }

      .demo-modale-texte {
        margin-top: var(--space-2xs);
        font-size: var(--text-sm);
        color: var(--color-muted);
      }

      .demo-modale-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2xs) var(--space-sm);
        margin-top: var(--space-md);
      }

      .demo-modale-cta {
        display: inline-block;
        padding: var(--space-2xs) var(--space-md);
        background: var(--color-accent);
        color: var(--color-on-accent);
        border-radius: var(--radius-pill);
        font-size: var(--text-sm);
        font-weight: var(--weight-bold);
        text-decoration: none;
      }

      .demo-modale-cta:hover {
        filter: brightness(1.06);
      }

      .demo-modale-lien {
        border: 0;
        background: transparent;
        padding: 0;
        font: inherit;
        font-size: var(--text-sm);
        color: var(--color-muted);
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
      }

      .demo-modale-lien:hover {
        color: var(--color-ink);
      }
    </style>
  </body>
</html>
